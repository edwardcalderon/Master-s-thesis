{
  "name": "master-thesis-lab",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "docs:build": "node scripts/build-docs.mjs",
    "language:check": "node scripts/check-language-pair.mjs",
    "thesis:similarity": "node scripts/check-thesis-similarity.mjs check",
    "thesis:similarity:fetch": "node scripts/check-thesis-similarity.mjs fetch",
    "thesis:similarity:eval": "node scripts/evaluate-refscan-fixture.mjs",
    "experiment:mvp:run": "python3 experiments/cex_dex_mvp/run.py",
    "experiment:mvp:check": "python3 experiments/cex_dex_mvp/check_invariants.py",
    "experiment:mvp:sweep": "python3 experiments/cex_dex_mvp/sweep.py",
    "experiment:mvp:abm": "python3 experiments/cex_dex_mvp/abm.py",
    "experiment:mvp:h1c": "python3 experiments/cex_dex_mvp/h1c.py",
    "prepare": "husky",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:validate": "pnpm exec versioning validate --config versioning.config.json && pnpm version:check",
    "readme:sync": "node scripts/version.mjs sync --readme-only",
    "readme:update": "node scripts/version.mjs readme",
    "secrets:check": "pnpm exec versioning check-secrets",
    "release:patch": "node scripts/release-patch.mjs",
    "release:verify": "pnpm version:validate && pnpm language:check && pnpm secrets:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:build",
    "release": "pnpm release:verify"
  },
  "devDependencies": {
    "@edcalderon/versioning": "1.5.13",
    "husky": "^9.1.7",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
